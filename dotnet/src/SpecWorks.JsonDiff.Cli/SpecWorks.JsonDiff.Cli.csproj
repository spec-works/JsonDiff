<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SpecWorks.JsonDiff\SpecWorks.JsonDiff.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- .NET Tool Configuration -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>jsondiff</ToolCommandName>

    <!-- NuGet Package Properties -->
    <PackageId>SpecWorks.JsonDiff.Cli</PackageId>
    <Version>1.0.0</Version>
    <Authors>SpecWorks</Authors>
    <Company>SpecWorks</Company>
    <Product>SpecWorks.JsonDiff.Cli</Product>
    <Description>Command-line tool for generating RFC 6902 JSON Patch documents by comparing two JSON files. Strictly implements RFC 6902 with no proprietary formats or extensions. Part of the SpecWorks specification-based component collection.</Description>
    <PackageTags>json;patch;diff;rfc6902;jsonpatch;cli;tool;dotnet-tool;specworks</PackageTags>
    <PackageProjectUrl>https://github.com/yourusername/spec-works</PackageProjectUrl>
    <RepositoryUrl>https://github.com/yourusername/spec-works</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Initial release (v1.0) - CLI tool for RFC 6902 JSON Patch generation.</PackageReleaseNotes>
    <Copyright>Copyright (c) 2026 SpecWorks</Copyright>

    <!-- Assembly Configuration -->
    <AssemblyName>jsondiff</AssemblyName>
    <RootNamespace>SpecWorks.JsonDiff.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
